{
  "name": "amplitude-demo-builder",
  "version": "2.0.0",
  "description": "Professional client demo generator for Amplitude Analytics with historical data backfill, multi-industry support, and enhanced attribution tracking.",
  "main": "src/server/demo-server.js",
  "scripts": {
    "start": "node src/server/demo-server.js",
    "dev": "nodemon src/server/demo-server.js",
    "demo:ecommerce": "DEMO_INDUSTRY=ecommerce node src/server/demo-server.js",
    "demo:saas": "DEMO_INDUSTRY=saas node src/server/demo-server.js",
    "demo:iot": "DEMO_INDUSTRY=iot node src/server/demo-server.js",
    "demo:hospitality": "DEMO_INDUSTRY=hospitality node src/server/demo-server.js",
    "test": "node test/test-config.js",
    "validate": "node scripts/validate-config.js",
    "list-industries": "node scripts/list-industries.js",
    "setup": "node scripts/setup.js",
    "setup-template": "node scripts/setup-template.js",
    "create-client-demo": "node scripts/create-client-demo.js",
    "generate": "node scripts/create-client-demo.js"
  },
  "keywords": [
    "amplitude",
    "analytics",
    "demo",
    "client-generator",
    "historical-data",
    "batch-api",
    "multi-industry",
    "utm-attribution",
    "sales-demo",
    "proof-of-concept"
  ],
  "author": {
    "name": "James",
    "email": "feedback@amplitude-demo.com",
    "url": "https://github.com/james"
  },
  "license": "MIT",
  "dependencies": {
    "@amplitude/analytics-node": "^1.3.5",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "socket.io": "^4.8.1",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/amplitude-demo-builder"
  },
  "bugs": {
    "url": "https://github.com/yourusername/amplitude-demo-builder/issues"
  },
  "homepage": "https://github.com/yourusername/amplitude-demo-builder#readme"
}